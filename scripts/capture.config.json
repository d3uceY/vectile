{
  "defaults": {
    "url": "http://127.0.0.1:9255",
    "routeStub": "./scripts/vectile-stub.mjs",
    "interact": "./scripts/vectile-interact.mjs",
    "ready": "#root",
    "timeoutMs": 30000,
    "retries": 2,
    "ignoreFailedRequests": ["/wails/custom.js"]
  },
  "pages": [
    {
      "name": "search",
      "out": "docs/static/img/screenshots/search.png",
      "interactView": "search",
      "query": "kubernetes rollout"
    },
    {
      "name": "search-passage",
      "out": "docs/static/img/screenshots/search-passage.png",
      "interactView": "search",
      "query": "kubernetes rollout",
      "searchExpand": true
    },
    {
      "name": "library",
      "out": "docs/static/img/screenshots/library.png",
      "interactView": "library"
    },
    {
      "name": "browse",
      "out": "docs/static/img/screenshots/browse.png",
      "interactView": "browse"
    },
    {
      "name": "index",
      "out": "docs/static/img/screenshots/index.png",
      "interactView": "index"
    },
    {
      "name": "settings",
      "out": "docs/static/img/screenshots/settings.png",
      "interactView": "settings"
    },
    {
      "name": "settings-sources",
      "out": "docs/static/img/screenshots/settings-sources.png",
      "interactView": "settings",
      "settingsSection": "Sources"
    },
    {
      "name": "settings-chunking",
      "out": "docs/static/img/screenshots/settings-chunking.png",
      "interactView": "settings",
      "settingsSection": "Chunking"
    },
    {
      "name": "settings-search",
      "out": "docs/static/img/screenshots/settings-search.png",
      "interactView": "settings",
      "settingsSection": "Search"
    },
    {
      "name": "settings-cache",
      "out": "docs/static/img/screenshots/settings-cache.png",
      "interactView": "settings",
      "settingsSection": "Cache"
    },
    {
      "name": "settings-ocr",
      "out": "docs/static/img/screenshots/settings-ocr.png",
      "interactView": "settings",
      "settingsSection": "OCR"
    },
    {
      "name": "ocr-setup",
      "out": "docs/static/img/screenshots/ocr-setup.png",
      "ocrDialog": true
    },
    {
      "name": "settings-indexing",
      "out": "docs/static/img/screenshots/settings-indexing.png",
      "interactView": "settings",
      "settingsSection": "Indexing"
    },
    {
      "name": "settings-mascot",
      "out": "docs/static/img/screenshots/settings-mascot.png",
      "interactView": "settings",
      "settingsSection": "vexter"
    },
    {
      "name": "settings-connect",
      "out": "docs/static/img/screenshots/settings-connect.png",
      "interactView": "settings",
      "settingsSection": "Connect",
      "loadingSelectors": [
        "[aria-busy=\"true\"]",
        ".skeleton",
        "[class*=\"skeleton\" i]",
        ".spinner",
        "[class*=\"spinner\" i]"
      ]
    }
  ]
}
